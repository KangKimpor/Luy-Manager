# Supabase: from Project Settings > API Keys in the dashboard.
#
# Safe to expose to the browser: Row Level Security (migration 0001) is the
# access boundary, and this key grants nothing without a session.
#
# Takes either a publishable key (sb_publishable_..., the current style, and
# rotatable without invalidating the JWT secret) or a legacy anon JWT. Both
# resolve to the `anon` Postgres role, so RLS behaves identically. The variable
# name predates the newer keys and is kept because src/lib/supabase/env.ts and
# every deployment already read it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string, from Project Settings > Database. Only used by
# `npm run connect` to apply migrations; the app itself never opens a direct
# database connection, it goes through PostgREST.
SUPABASE_DB_URL=

# Server-side only. Bypasses Row Level Security entirely, so it must never be
# prefixed NEXT_PUBLIC_ or referenced from a client component.
# Needed for the exchange-rate writer and the Telegram webhook, which act
# without a user session.
#
# Takes either a secret key (sb_secret_...) or a legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the daily exchange rate job at /api/rates/refresh.
# The route refuses to run at all when this is unset, because an unprotected
# endpoint that writes to the database is worse than a missing feature. Vercel
# Cron sends it automatically as "Authorization: Bearer $CRON_SECRET"; any other
# scheduler can send "X-Cron-Secret" instead.
#
# The schedule lives in vercel.json: 01:30 UTC daily, which is 08:30 in Phnom
# Penh. That is after the upstream providers publish their new figure just after
# 00:00 UTC, and early enough that the rate is current before the day's spending.
CRON_SECRET=

# Telegram bot (PRD Section 9). From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=

# Shared secret echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Without it, anyone who learns the webhook URL can post fake updates.
#
# Also signs the account-connect deep links, so changing it invalidates any link
# that has been handed out but not yet used. Generate with `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# The bot's @username, without the @. Public by nature, so NEXT_PUBLIC_.
# Only used to build the "Connect Telegram" link on the settings page; without it
# that card explains the bot is not set up rather than linking nowhere.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
