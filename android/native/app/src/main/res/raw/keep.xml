<?xml version="1.0" encoding="utf-8"?>
<!--
  Ui.iconRes resolves category and navigation icons by name at runtime
  (getIdentifier("ic_" + name, "drawable", ...)), so the resource shrinker sees no
  reference to them. Keep every ic_ drawable; the manifest keeps ic_luy on its own.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_*" />
